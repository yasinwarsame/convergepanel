# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# pdf.js worker, copied from node_modules/pdfjs-dist at build time
# (scripts/pdfjs-worker/materialize.js). Never commit it: a committed copy could
# drift from the installed package, and the build regenerates it every time.
/public/vendor/pdfjs/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# key storage (dev only - deprecated, now using database)
.data/

# Prisma
prisma/migrations/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts


.env.local

# Sentry Config File
.env.sentry-build-plugin

# Editor / tooling
.claude/
.cursor/
.mcp.json

# Setup reports
SEO_AUDIT.md
posthog-setup-report.md

# Workspace provisioning result artifacts (contain real user ids)
workspace-provisioning-*.json

# Firestore emulator artefacts (rules tests)
firestore-debug.log
firebase-debug.log
