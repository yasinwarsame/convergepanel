rules_version = '2';

// ConvergePanel Firestore Security Rules
//
// Phase FIRESTORE-AUTHZ-P0.1 — THE CLIENT/SERVER AUTHORITY BOUNDARY.
//
// These rules govern the WEB SDK only. The Firebase Admin SDK used by every
// API route bypasses them entirely and is authorised by service-account
// credentials, so tightening them here cannot block a legitimate server
// writer — it only removes the browser's reach.
//
// THE DEFECT THIS CLOSES. `/users/{uid}` previously granted
// `allow read, write: if request.auth.uid == uid` — an unrestricted,
// field-level write on the whole document. That document is not profile data;
// it is where this application keeps its billing and entitlement authority.
// `calculateEffectiveEntitlement()` reads `override`, `planFromStripe`,
// `plan`, `subscriptionStatusFromStripe` and `subscriptionStatus` from it; the
// quota gate reads `runsThisMonth` and `usageMonth`; governance role
// resolution reads `role` and `email`. All of it was writable from a browser
// console with the user's own credentials. A comment in
// lib/admin/entitlements.ts asserted the opposite; it has been corrected.
//
// THE RULE IS AN ALLOWLIST, NOT A DENYLIST. Client writes are restricted to an
// explicit set of client-owned fields via `hasOnly()`. This is deliberate: a
// denylist protects only the sensitive fields someone remembered to list,
// whereas an allowlist means ANY field added later — a new limit, a new grant,
// a new flag — is server-owned by default until someone consciously exposes
// it. The failure mode of forgetting is then a broken client write in
// development, not a silent privilege escalation in production.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdminClaim() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    match /users/{uid} {

      // Fields the browser legitimately owns: identity it already proved, and
      // the profile/onboarding answers the user types in themselves.
      //
      // Everything absent from this list is SERVER-OWNED, including — but
      // deliberately not limited to — plan, planFromStripe, planLabel,
      // entitlements, override, subscriptionStatus,
      // subscriptionStatusFromStripe, billingInterval, billingCycleStart,
      // currentPeriodEnd, stripeCustomerId, stripeSubscriptionId,
      // monthlyLimit, maxModels, maxModelsPerRun, runsThisMonth,
      // videoRunsThisMonth, usageMonth, tokensUsedCurrentPeriod, totalRuns,
      // role, isDisabled, governanceReviewerEnabled, governanceReviewerFor,
      // governanceReviewerEmail and planUpdatedAt.
      function createFields() {
        return [
          'uid', 'email', 'name', 'phone', 'address',
          'onboardingRole', 'primaryUseCase', 'expectedUsage', 'referralSource',
          'onboardingCompleted',
          'createdAt', 'updatedAt', 'lastLoginAt'
        ];
      }

      // Phase P0.1-R2 — `uid`, `email` and `createdAt` ARE in the update set.
      //
      // Excluding them was wrong, and it broke sign-in. Sign-in re-sends
      // `{uid, email, lastLoginAt}` on every login, and FIVE server paths
      // create this document with neither `uid` nor `email`
      // (lib/stripe/usageCheck.ts, lib/userUsage.ts, lib/stripe/usage.ts,
      // app/api/user/usage/route.ts, app/api/teams/members/route.ts). Against
      // such a document those keys are genuine additions, `affectedKeys()`
      // reports them, and the write was denied — leaving the user
      // authenticated in Firebase Auth but stuck on a permissions error,
      // because the login handler's catch returns without redirecting.
      //
      // ADMITTING THE KEY IS NOT ADMITTING THE VALUE. The security control is
      // `identityPinned()` below, not this list: the key may appear, but its
      // value can only ever be the caller's own authenticated identity. That is
      // strictly stronger than the previous arrangement, which relied on the
      // key being absent — and it lets a stale mirror self-heal to the current
      // verified address instead of being frozen wrong forever.
      function updateFields() {
        return [
          'uid', 'email', 'createdAt',
          'name', 'phone', 'address',
          'onboardingRole', 'primaryUseCase', 'expectedUsage', 'referralSource',
          'onboardingCompleted',
          'updatedAt', 'lastLoginAt'
        ];
      }

      /**
       * THE IDENTITY PIN — the same control on create and on update.
       *
       * `uid`, if written, must equal the document path. `email`, if written,
       * must equal the address on the caller's own verified Firebase token.
       * A missing key is permitted (the schema does not require either), but a
       * WRONG one is refused, so no caller can forge identity metadata whether
       * the document is new, legacy, or already correct.
       *
       * Nulling is refused for free: `null == uid` is false.
       */
      function identityPinned() {
        return (!('uid' in request.resource.data) || request.resource.data.uid == uid)
               && (!('email' in request.resource.data) || request.resource.data.email == request.auth.token.email);
      }

      /**
       * Identity is write-once and cannot be removed. Without this, a client
       * could DELETE a correct `uid`/`email` — the pin above is vacuously true
       * for an absent key — and evade the binding rather than break it.
       */
      function identityNotRemoved() {
        return (!('uid' in resource.data) || 'uid' in request.resource.data)
               && (!('email' in resource.data) || 'email' in request.resource.data);
      }

      allow get: if isOwner(uid);

      // Phase P0.1-R2 — NO CLIENT LIST, INCLUDING FOR ADMINS.
      //
      // Firestore rules govern an externally callable API. That no first-party
      // browser code issues a list is a reason removal is cheap, NOT evidence
      // the grant was safe: any authenticated principal can construct a query
      // directly against the project with the public web config. The grant was
      // also strictly broader than the cross-user `get` this file deliberately
      // denies — it returned every user's Stripe ids, override state and
      // contact details in one query, with none of the audit logging the
      // /api/admin/* routes provide. Admin listing is served by those routes
      // through the Admin SDK, which does not consult these rules.
      allow list: if false;

      allow create: if isOwner(uid)
                    && request.resource.data.keys().hasOnly(createFields())
                    && identityPinned();

      allow update: if isOwner(uid)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(updateFields())
                    && identityPinned()
                    && identityNotRemoved();

      // The authoritative billing record is not the browser's to remove.
      // Deleting it would strip a paying customer's Stripe linkage and usage
      // counters, and the free document a later server bootstrap recreates
      // would not restore them. Account deletion runs server-side.
      allow delete: if false;
    }

    // App config - only admins can read/write model keys
    match /appConfig/modelKeys {
      allow read, write: if isAdminClaim();
    }

    // Default deny all other documents
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
