# Firebase Client Config
# Get these values from Firebase Console > Project Settings > Your apps > Web app
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyCUrboygS_YWxpdXa2pXVryebPzSnOUxdo
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=convergepanel.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=convergepanel
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=convergepanel.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=907484474744
NEXT_PUBLIC_FIREBASE_APP_ID=1:907484474744:web:19a931809616da203f6c8d

# Firebase Admin SDK (Service Account)
# Get these from Firebase Console > Project Settings > Service Accounts > Generate new private key
FIREBASE_PROJECT_ID=convergepanel
FIREBASE_CLIENT_EMAIL=your-service-account@convergepanel.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Admin Secret (for setting first admin via /api/admin/set-admin)
ADMIN_SECRET=your-long-random-secret-string-here

# Admin email allowlist (comma-separated). Users with these emails receive admin access.
# Required: set this in production or no one will have admin access.
ADMIN_EMAILS=admin@yourdomain.com,support@yourdomain.com

# Optional: API keys can be set here or via Admin UI
# Firestore keys take precedence over environment variables
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
XAI_API_KEY=your_xai_api_key_here
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# Team Workspace Invitations (Phase 8D.2) — transactional email.
# Leave unset locally unless you deliberately want to send real invitation
# email from your machine; sending fails closed (configuration_missing)
# when any of these are unset, never a fake success.
RESEND_API_KEY=
TRANSACTIONAL_EMAIL_FROM=
# Canonical public origin used to build invitation acceptance links.
# Production must use: APP_BASE_URL=https://convergepanel.com
APP_BASE_URL=
