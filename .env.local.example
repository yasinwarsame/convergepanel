# LOCAL DEVELOPMENT ONLY — use the ISOLATED (non-Production) Firebase project.
# Production Firebase ("convergepanel") is refused outside the Vercel Production deployment (lib/firebase/projectIsolation.ts);
# never put Production values or a Production service-account key here. Preferred: `vercel env pull --environment=development`
# once the isolated project exists. Production maintenance uses a separate operator checkout:
# docs/operations/firebase-environment-isolation.md.

# Firebase Client Config (isolated project: Firebase Console > Project Settings > Your apps > Web app)
NEXT_PUBLIC_FIREBASE_API_KEY=<isolated-project-web-api-key>
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=<isolated-project-id>.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=<isolated-project-id>
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=<isolated-project-id>.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=<isolated-project-number>
NEXT_PUBLIC_FIREBASE_APP_ID=<isolated-project-web-app-id>

# Firebase Admin SDK, for the isolated (non-Production) project only.
# Preferred: keyless. Sign in with your own Google account, impersonating the developer service account
#   gcloud auth application-default login --impersonate-service-account=cp-dev-admin@<isolated-project-id>.iam.gserviceaccount.com
# and set (GOOGLE_APPLICATION_CREDENTIALS must be unset; the Production project is refused):
FIREBASE_ADMIN_CREDENTIAL_SOURCE=adc
FIREBASE_PROJECT_ID=<isolated-project-id>
# Legacy alternative (a key file of the isolated project; never a Production key). Leave unset with the keyless path.
# FIREBASE_CLIENT_EMAIL=<service-account>@<isolated-project-id>.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Admin email allowlist (comma-separated). Users with these emails receive admin access.
# Required: set this in production or no one will have admin access.
ADMIN_EMAILS=admin@yourdomain.com,support@yourdomain.com

# Optional: API keys can be set here or via Admin UI
# Firestore keys take precedence over environment variables
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
XAI_API_KEY=your_xai_api_key_here
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# Team Workspace Invitations (Phase 8D.2) — transactional email.
# Leave unset locally unless you deliberately want to send real invitation
# email from your machine; sending fails closed (configuration_missing)
# when any of these are unset, never a fake success.
RESEND_API_KEY=
TRANSACTIONAL_EMAIL_FROM=
# Canonical public origin used to build invitation acceptance links.
# Production must use: APP_BASE_URL=https://convergepanel.com
APP_BASE_URL=
