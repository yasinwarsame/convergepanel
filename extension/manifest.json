{
  "manifest_version": 3,
  "name": "ConvergePanel Verify",
  "version": "0.1.0",
  "description": "Verify claims, AI answers, and online content with ConvergePanel.",
  "permissions": ["contextMenus", "storage", "activeTab"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Verify with ConvergePanel"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
