    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.35",
    "jest": "^30.4.2",
    "playwright": "^1.60.0",
    "postcss": "^8.4.35",
    "prisma": "^5.19.0",
    "react-test-renderer": "^18.3.1",
    "tailwindcss": "^3.4.1",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
