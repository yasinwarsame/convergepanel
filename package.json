    "firebase": "^12.6.0",
    "firebase-admin": "^12.7.0",
    "next": "^14.2.33",
    "openai": "^4.47.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
