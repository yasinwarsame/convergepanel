    "verify:linkedin-copy": "node scripts/dev-verify-linkedin-copy.mjs",
    "verify:low-remaining": "node scripts/dev-verify-low-remaining-indicator.mjs",
    "verify:claims": "node scripts/dev-verify-claim-verification.mjs",
    "verify:policies": "node scripts/dev-verify-policy-engine.mjs",
    "verify:consensus": "node scripts/dev-verify-consensus-scoring.mjs",
    "verify:governance": "node scripts/dev-verify-governance.mjs",
    "verify:video": "node scripts/dev-verify-video-processing.mjs",
    "seo:indexnow": "node scripts/submit-indexnow.mjs",
    "governance:seed": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/seed-adaptive-multi-reviewer-e2e.ts",
    "governance:seed:cleanup": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/cleanup-adaptive-multi-reviewer-e2e.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.20.0",
