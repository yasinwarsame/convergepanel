    "firebase": "^12.6.0",
    "firebase-admin": "^12.7.0",
    "lucide-react": "^1.0.1",
    "mammoth": "^1.12.0",
    "next": "^14.2.33",
    "openai": "^4.47.0",
    "pdfjs-dist": "^6.0.227",
    "posthog-js": "^1.379.1",
    "posthog-node": "^5.35.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "sharp": "^0.34.5",
    "stripe": "^20.0.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.11.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
